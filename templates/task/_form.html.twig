{{ form_start(form, {attr: {class: 'row g-3'}}) }}

    {% for field in form %}
        <div class="col-md-6">
            <label class="form-label">{{ field.vars.label }}</label>
            {{ form_widget(field, {attr: {class: 'form-control'}}) }}
            {{ form_errors(field) }}
        </div>
    {% endfor %}

    <div class="col-12">
        <button type="submit" class="btn btn-primary">{{ buttonLabel|default('Enregistrer') }}</button>
        <a href="{{ path('app.task.index') }}" class="btn btn-secondary">Annuler</a>
    </div>

{{ form_end(form) }}
